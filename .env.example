# LLM Configuration
LLM_API_KEY= ur key here from groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.0

# Search Configuration
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
SEARCH_BASE_URL=https://www.googleapis.com/customsearch/v1

# NLI Configuration
NLI_MODEL=ynie/roberta-large-snli_mnli_fever_anli_R1_R2_R3-nli
NLI_DEVICE=cpu
NLI_MODE=mock

# Debate Configuration
DISAGREEMENT_THRESHOLD=0.70
ENTAILMENT_THRESHOLD=0.70
MAX_DEBATE_ROUNDS=3
MAX_SEARCH_RESULTS=5
ALLOW_RULE_FALLBACK=true

# Application
DEMO_MODE=false
LOG_LEVEL=INFO
