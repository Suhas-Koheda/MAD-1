  Extra Metrics You Can Add
  
  These are not implemented yet — you can add them by editing evaluation/metrics.py in the calculate_metrics() function:
  
  # Add these to the return dict in calculate_metrics():
  
  # 1. Average contradiction score when debate triggers
  avg_contra = statistics.mean(
      r.contradiction_score for r in self.results
      if r.debate_triggered and r.contradiction_score
  ) if any(r.debate_triggered for r in self.results) else 0.0
  
  # 2. Debate early stop rate (how often it converged before max rounds)
  early_stops = sum(
      1 for r in self.results
      if r.metrics.get("debate_stop_reason") in ("converged", "no_objection")
  )
  early_stop_rate = early_stops / max(sum(1 for r in self.results if r.debate_triggered), 1)
  
  # 3. Average source count per answer
  avg_sources = statistics.mean(
      r.metrics.get("source_count", 0) for r in ok_traces
  ) if ok_traces else 0.0
  
  # 4. Per-conflict-type accuracy
  conflict_acc = {}
  for ctype in ["temporal", "version", "contextual", "source", "factual"]:
      typed = [r for r in self.results if r.conflict and r.conflict.type.value == ctype]
      correct = [r for r in typed if r.router_result.get("expected_conflict_type") == ctype]
      conflict_acc[ctype] = len(correct) / len(typed) if typed else 0.0
  
